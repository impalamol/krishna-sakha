# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Optional settings
PORT=3000
MODEL=claude-opus-5-5
# low | medium | high  (higher = deeper answers, slower, more cost)
EFFORT=medium
# Requests allowed per visitor IP in each 10-minute window
RATE_LIMIT=30

# Set to false to hide the chat box (visitors see a "studying" notice). Chat also hides when no API key is set.
CHAT_ENABLED=true

# Owner password for the Library panel (upload books, media, links). Leave empty to turn the Library off.
ADMIN_PASSWORD=

# Natural voice. Default: Microsoft neural male voices (Madhur hi, Manohar mr, Prabhat en, + bn ta te kn ml gu ur)
# through the free Edge "Read aloud" service, no key needed. It is unofficial, so if it fails Piper takes over.
# Set TTS_EDGE=false to stop using it.
TTS_EDGE=true
# Same voices, official and guaranteed: add an Azure Speech key (free tier: 0.5M characters/month).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Set to false to turn Piper off
TTS_PIPER=true
# Piper voices: Hindi "hi_IN-rohan-medium" (default) or "hi_IN-pratham-medium"; English "en_GB-alan-medium" (default, fast) or "en_US-ryan-high" (richer but slower)
PIPER_HINDI_VOICE=
PIPER_ENGLISH_VOICE=

# Offline translation (NLLB-200, free, NON-COMMERCIAL licence) so summaries come in the chosen language. Set to false to turn off.
TRANSLATE_LOCAL=true

# Language of uploaded talks for speech-to-text (hindi, english, marathi, sanskrit...). A file named '...English...' is always English.
WHISPER_LANGUAGE=hindi

# Speech-to-text model. Default Xenova/whisper-medium (accurate, ~210 MB download once, slower).
# Xenova/whisper-small is ~3x faster but mishears more. Changing it re-listens old recordings automatically.
WHISPER_MODEL=Xenova/whisper-medium

# Understanding: with the AI on, after reading each text he studies it (Claude Haiku 5.5 close reading +
# MODEL reflection) and saves his understanding in library/.knowledge/understanding (used offline too).
# Roughly $15-25 once for a library of ~100 books; each text is studied only once. Set false to turn off.
UNDERSTAND=true

# Local brain: a free open model running on this computer in Ollama (https://ollama.com). When Claude is
# unavailable (no key, no credits, outage) he still thinks with it: answers in his own words from his books,
# and keeps studying what he has read. Install Ollama, then: ollama pull gemma3:4b
LOCAL_BRAIN=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# context window in tokens (higher = more memory)
OLLAMA_CTX=8192
# true = texts studied by the local brain are studied again by Claude (costs credits) once the AI is on
UNDERSTAND_UPGRADE=false
# GPU layers for the local model: 99 = whole model on the GPU (fastest; falls back by itself), auto = Ollama decides
OLLAMA_GPU_LAYERS=99
# Languages the local model writes poorly are answered in English and translated offline (NLLB), sentence by
# sentence. Comma-separated codes (hi mr bn ta te kn ml gu pa ur); default: ml (Malayalam). Empty = none.
LOCAL_TRANSLATE_LANGS=ml
